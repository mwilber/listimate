{
  "name": "Listimate",
  "short_name": "Listimate",
  "display": "standalone",
  "orientation": "portrait",
  "start_url": "/",
  "scope": "/",
  "background_color": "#ffffff",
  "theme_color": "#306e4f",
  "icons": [
    {
      "src": "/public/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/public/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/public/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
